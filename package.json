{
  "name": "@crossecute/sdk",
  "version": "0.1.0",
  "description": "Foundry and TypeScript helpers for building, simulating and checking Crossecute operations",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts/*": "./contracts/*"
  },
  "bin": {
    "crossecute": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "contracts",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "npm run test:forge && npm run test:ts",
    "test:forge": "forge test",
    "test:ts": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test:attest": "scripts/check-forge-attest.sh"
  },
  "dependencies": {
    "@crossecute/protocol": "0.1.0",
    "viem": "2.57.18"
  },
  "peerDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "@types/node": "26.6.6",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crossecute/sdk.git"
  }
}
